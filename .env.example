# App
ENV=development
PYTHONPATH=.


# Database
DATABASE_URL=sqlite:///data/processed/portfolio.db
POSTGRESQL_DB_USER="postgres"
POSTGRESQL_DB_PASSWORD="password234"
POSTGRESQL_DB_HOST="localhost"
POSTGRESQL_DB_PORT=5432
POSTGRESQL_DB_NAME="postgres"

MONGO_URI="mongodb://admin:password@localhost:27017/"


# YFinance Parameters
# Global spacing between yfinance requests, shared by every worker in the
# process. Transient Yahoo errors (429/403/5xx) are retried with exponential
# backoff below, which also temporarily multiplies this interval.
YF_GLOBAL_MIN_INTERVAL_SECONDS=1.5
YF_BACKOFF_MAX_RETRIES=5
YF_BACKOFF_BASE_SECONDS=5
YF_BACKOFF_MAX_SECONDS=120
# Re-fetch a whole batch that comes back empty (silent rate limiting)
YF_CASHFLOW_EMPTY_RETRIES=3
YF_CASHFLOW_EMPTY_BACKOFF_SECONDS=10
YF_HISTORICAL_PERIOD=max
YF_HISTORICAL_START=
YF_HISTORICAL_END=
YF_HISTORICAL_INTERVAL=1d


# Crawler Config
START_DATE="2000-01-01"
END_DATE=